#include <stdio.h>

#define MAX_VERTICES 20
#define MAX_EDGES 50

int vertices;
int edges;

int edgeList[MAX_EDGES][2];
int edgeColor[MAX_EDGES];

int colorLimit;

/*
    Checks whether a color can be assigned to an edge.

    Two edges are adjacent if they share at least one vertex.
    Adjacent edges cannot have the same color.
*/
int isSafe(int edgeIndex, int color)
{
    int u = edgeList[edgeIndex][0];
    int v = edgeList[edgeIndex][1];

    for (int i = 0; i < edgeIndex; i++)
    {
        int x = edgeList[i][0];
        int y = edgeList[i][1];

        // Check whether the two edges share a vertex
        if (u == x || u == y || v == x || v == y)
        {
            if (edgeColor[i] == color)
            {
                return 0;
            }
        }
    }

    return 1;
}

/*
    Backtracking function.

    Attempts to assign a color to every edge.
*/
int edgeColoring(int edgeIndex)
{
    // All edges have been successfully colored
    if (edgeIndex == edges)
    {
        return 1;
    }

    // Try every available color
    for (int color = 1; color <= colorLimit; color++)
    {
        if (isSafe(edgeIndex, color))
        {
            edgeColor[edgeIndex] = color;

            // Recursively color the next edge
            if (edgeColoring(edgeIndex + 1))
            {
                return 1;
            }

            // Backtrack if this choice causes a conflict
            edgeColor[edgeIndex] = 0;
        }
    }

    return 0;
}

int main()
{
    printf("EDGE COLORING PROBLEM USING BACKTRACKING\n");
    printf("==========================================\n");

    printf("Enter number of vertices: ");
    scanf("%d", &vertices);

    printf("Enter number of edges: ");
    scanf("%d", &edges);

    if (vertices <= 0 || vertices > MAX_VERTICES ||
        edges <= 0 || edges > MAX_EDGES)
    {
        printf("Invalid input size.\n");
        return 1;
    }

    printf("\nEnter each edge as two vertices:\n");

    for (int i = 0; i < edges; i++)
    {
        printf("Edge %d: ", i + 1);
        scanf("%d %d",
              &edgeList[i][0],
              &edgeList[i][1]);

        edgeColor[i] = 0;
    }

    printf("\nEnter maximum number of colors: ");
    scanf("%d", &colorLimit);

    if (colorLimit <= 0)
    {
        printf("Invalid number of colors.\n");
        return 1;
    }

    if (edgeColoring(0))
    {
        printf("\nValid edge coloring found!\n");
        printf("\nEdge Colors:\n");

        for (int i = 0; i < edges; i++)
        {
            printf("Edge (%d, %d) -> Color %d\n",
                   edgeList[i][0],
                   edgeList[i][1],
                   edgeColor[i]);
        }
    }
    else
    {
        printf("\nNo valid edge coloring exists with %d colors.\n",
               colorLimit);
    }

    return 0;
}
