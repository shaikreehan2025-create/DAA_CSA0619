#include <stdio.h>
#include <math.h>

/*
    Smart Grid Fault Detection using Pattern Detection

    The program analyzes sensor readings from a power grid.
    A sudden change in sensor value is treated as a possible
    fault/anomaly.

    Threshold-based pattern detection is used because it is
    simple and fast enough for real-time monitoring.
*/

#define MAX_SENSORS 100
#define THRESHOLD 20.0

// Function to detect abnormal changes in sensor readings
void detectFaults(double readings[], int n)
{
    int faultFound = 0;

    printf("\nFault Detection Results\n");
    printf("-----------------------\n");

    for (int i = 1; i < n; i++)
    {
        // Calculate change between consecutive readings
        double change = fabs(readings[i] - readings[i - 1]);

        if (change > THRESHOLD)
        {
            printf("Fault detected between readings %d and %d\n",
                   i - 1, i);

            printf("Previous reading : %.2f\n", readings[i - 1]);
            printf("Current reading  : %.2f\n", readings[i]);
            printf("Change           : %.2f\n\n", change);

            faultFound = 1;
        }
    }

    if (!faultFound)
    {
        printf("No abnormal pattern detected.\n");
    }
}

int main()
{
    int n;
    double readings[MAX_SENSORS];

    printf("Smart Grid Fault Detection System\n");
    printf("==================================\n");

    printf("Enter number of sensor readings: ");
    scanf("%d", &n);

    if (n < 2 || n > MAX_SENSORS)
    {
        printf("Invalid number of readings.\n");
        return 1;
    }

    printf("Enter sensor readings:\n");

    for (int i = 0; i < n; i++)
    {
        scanf("%lf", &readings[i]);
    }

    detectFaults(readings, n);

    printf("\nAnalysis:\n");
    printf("Detection method: Consecutive-pattern comparison\n");
    printf("Threshold: %.2f\n", THRESHOLD);
    printf("Time Complexity: O(n)\n");
    printf("Space Complexity: O(1) extra space\n");

    return 0;
}
