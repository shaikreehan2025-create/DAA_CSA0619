#include <stdio.h>
#include <string.h>

#define MAX 100

/*
    Assembly Line Scheduling and Word Break
    ---------------------------------------
    Both problems are solved using Dynamic Programming.

    Part 1:
    Assembly Line Scheduling finds the minimum time required
    to process a product through two assembly lines.

    Part 2:
    Word Break determines whether a string can be segmented
    into valid words from a given dictionary.
*/

// ---------------------------------------------------------
// ASSEMBLY LINE SCHEDULING
// ---------------------------------------------------------

int min(int a, int b)
{
    return (a < b) ? a : b;
}

int assemblyLineScheduling(
    int a[2][MAX],
    int t[2][MAX],
    int e[2],
    int x[2],
    int n)
{
    int dp1[MAX];
    int dp2[MAX];

    // Initial processing times
    dp1[0] = e[0] + a[0][0];
    dp2[0] = e[1] + a[1][0];

    // Calculate minimum time for each station
    for (int i = 1; i < n; i++)
    {
        dp1[i] = min(
            dp1[i - 1] + a[0][i],
            dp2[i - 1] + t[1][i - 1] + a[0][i]
        );

        dp2[i] = min(
            dp2[i - 1] + a[1][i],
            dp1[i - 1] + t[0][i - 1] + a[1][i]
        );
    }

    // Add exit times
    return min(
        dp1[n - 1] + x[0],
        dp2[n - 1] + x[1]
    );
}

// ---------------------------------------------------------
// WORD BREAK
// ---------------------------------------------------------

int dictionaryContains(char word[], char dictionary[][MAX], int dictionarySize)
{
    for (int i = 0; i < dictionarySize; i++)
    {
        if (strcmp(word, dictionary[i]) == 0)
            return 1;
    }

    return 0;
}

int wordBreak(char str[], char dictionary[][MAX], int dictionarySize)
{
    int n = strlen(str);
    int dp[MAX + 1] = {0};

    // Empty string can always be segmented
    dp[0] = 1;

    for (int i = 1; i <= n; i++)
    {
        for (int j = 0; j < i; j++)
        {
            if (dp[j])
            {
                char word[MAX];
                int length = i - j;

                strncpy(word, str + j, length);
                word[length] = '\0';

                if (dictionaryContains(word, dictionary, dictionarySize))
                {
                    dp[i] = 1;
                    break;
                }
            }
        }
    }

    return dp[n];
}

// ---------------------------------------------------------
// MAIN FUNCTION
// ---------------------------------------------------------

int main()
{
    // ============================================
    // ASSEMBLY LINE SCHEDULING EXAMPLE
    // ============================================

    int n = 4;

    int a[2][MAX] =
    {
        {4, 5, 3, 2},
        {2, 10, 1, 4}
    };

    int t[2][MAX] =
    {
        {0, 7, 4, 5},
        {0, 9, 2, 8}
    };

    int e[2] = {10, 12};
    int x[2] = {18, 7};

    int minimumTime =
        assemblyLineScheduling(a, t, e, x, n);

    printf("ASSEMBLY LINE SCHEDULING\n");
    printf("========================\n");

    printf("Minimum processing time = %d\n\n",
           minimumTime);

    // ============================================
    // WORD BREAK EXAMPLE
    // ============================================

    char str[MAX] = "applepie";

    char dictionary[][MAX] =
    {
        "apple",
        "pie",
        "app",
        "le"
    };

    int dictionarySize =
        sizeof(dictionary) / sizeof(dictionary[0]);

    int possible =
        wordBreak(str, dictionary, dictionarySize);

    printf("WORD BREAK\n");
    printf("==========\n");

    printf("String: %s\n", str);

    if (possible)
        printf("The string can be segmented into valid words.\n");
    else
        printf("The string cannot be segmented into valid words.\n");

    return 0;
}
