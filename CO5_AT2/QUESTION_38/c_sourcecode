#include <stdio.h>
#include <string.h>

#define MAX 20

char elements[MAX];
char permutation[MAX];
int used[MAX];

int n;

/*
    restrictions[position][element]

    1 = element is NOT allowed at this position
    0 = element is allowed
*/
int restrictions[MAX][MAX];


/*
    Checks whether an element can be placed
    at the given position.
*/
int isAllowed(int position, int elementIndex)
{
    if (restrictions[position][elementIndex] == 1)
    {
        return 0;
    }

    return 1;
}


/*
    Prints the current permutation.
*/
void printPermutation()
{
    for (int i = 0; i < n; i++)
    {
        printf("%c ", permutation[i]);
    }

    printf("\n");
}


/*
    Backtracking function.

    Builds the permutation one position at a time.
*/
void generatePermutations(int position)
{
    // Base case:
    // All positions have been filled.
    if (position == n)
    {
        printPermutation();
        return;
    }

    // Try every element.
    for (int i = 0; i < n; i++)
    {
        // Skip an element that has already been used.
        if (used[i])
        {
            continue;
        }

        // Pruning:
        // Reject the element if it is restricted
        // at the current position.
        if (!isAllowed(position, i))
        {
            continue;
        }

        // Choose the element.
        permutation[position] = elements[i];
        used[i] = 1;

        // Recursively fill the next position.
        generatePermutations(position + 1);

        // Undo the choice (backtracking).
        used[i] = 0;
    }
}


int main()
{
    int r;
    int position;
    char restrictedElement;

    printf("PERMUTATION GENERATION WITH POSITION RESTRICTIONS\n");
    printf("=================================================\n");

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX)
    {
        printf("Invalid number of elements.\n");
        return 1;
    }

    printf("Enter %d distinct elements:\n", n);

    for (int i = 0; i < n; i++)
    {
        scanf(" %c", &elements[i]);
        used[i] = 0;
    }

    // Initialize restrictions.
    for (int i = 0; i < MAX; i++)
    {
        for (int j = 0; j < MAX; j++)
        {
            restrictions[i][j] = 0;
        }
    }

    printf("\nEnter number of restrictions: ");
    scanf("%d", &r);

    printf("\nEnter restrictions as: position element\n");
    printf("Example: 1 A means A cannot be at position 1.\n\n");

    for (int i = 0; i < r; i++)
    {
        printf("Restriction %d: ", i + 1);
        scanf("%d %c", &position, &restrictedElement);

        // Find the element index.
        int found = 0;

        for (int j = 0; j < n; j++)
        {
            if (elements[j] == restrictedElement)
            {
                restrictions[position - 1][j] = 1;
                found = 1;
                break;
            }
        }

        if (!found)
        {
            printf("Warning: Element %c is not in the set.\n",
                   restrictedElement);
        }
    }

    printf("\nValid Permutations:\n");
    printf("-------------------\n");

    generatePermutations(0);

    return 0;
}
